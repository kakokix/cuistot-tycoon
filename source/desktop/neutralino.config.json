{
  "applicationId": "fr.cuistot.tycoon",
  "applicationName": "Cuistot Tycoon",
  "author": "Cuistot Tycoon",
  "description": "Cuistot Tycoon - le resto de la jungle",
  "copyright": "Cuistot Tycoon 2026",
  "version": "1.4.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "storage.*",
    "events.*",
    "filesystem.*",
    "server.*",
    "os.open",
    "os.getPath"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "Cuistot Tycoon",
      "width": 1280,
      "height": 800,
      "minWidth": 420,
      "minHeight": 560,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "CuistotTycoon",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}